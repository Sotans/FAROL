# Copie este arquivo para .env.local e preencha com os dados do seu projeto Supabase
# (Project Settings > Data API e API Keys). O .env.local não vai para o GitHub.
# A chave "publishable" é pública por definição: a proteção dos dados está nas regras (RLS) do banco.
# Nunca coloque aqui a chave "secret" nem a senha do banco.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
